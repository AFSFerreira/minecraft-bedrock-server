# Segredo do frp — nunca versionar
.env

# Log gerado pelo cron do backup (just cron-install)
backup.log

# Tudo dentro de data/ fica de fora por padrao, EXCETO o mundo (save) —
# o resto e conteudo padrao da engine (vanilla_*, chemistry_*, experimental_*,
# editor, server_library etc.) ou copias extraidas dos addons que ja estao
# versionados em addons/ na forma original (.mcpack/.mcaddon).
data/*
!data/worlds/
